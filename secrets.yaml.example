# Copy these lines into your own secrets.yaml in ESPHome
# (ESPHome Device Builder > top right "Secrets").
# You get an API key when you create a new device in ESPHome,
# or see: https://esphome.io/components/api/

wifi_ssid: "YourWifiName"
wifi_password: "YourWifiPassword"
ap_password: "choose-a-password"
ota_password: "choose-a-password"
babyfoon_api_key: "paste-a-32-byte-base64-key-here="

# Stream access key (min. 24 characters). Generate with: openssl rand -hex 24
babyfoon_stream_key: "paste-a-48-character-hex-key-here-000000000000"
